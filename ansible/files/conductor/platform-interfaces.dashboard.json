{
 "uid": "platform-interfaces",
 "title": "Platform interfaces",
 "tags": [
  "echoctf"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "server",
    "label": "Server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(ifHCInOctets, instance)",
     "refId": "s"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "iface",
    "label": "Interface",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(ifHCInOctets{instance=~\"$server\"}, ifDescr)",
     "refId": "i"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1,
    "regex": "/^(?!enc0$).*/"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Inbound per server",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Inbound $server",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "repeat": "server",
   "repeatDirection": "h",
   "maxPerRow": 3,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(ifHCInOctets{instance=~\"$server\",ifDescr=~\"$iface\",ifDescr!~\"enc0\"}[$__rate_interval]) * 8",
     "legendFormat": "{{ifDescr}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "row",
   "title": "Outbound per server",
   "id": 3,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Outbound $server",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "repeat": "server",
   "repeatDirection": "h",
   "maxPerRow": 3,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(ifHCOutOctets{instance=~\"$server\",ifDescr=~\"$iface\",ifDescr!~\"enc0\"}[$__rate_interval]) * 8",
     "legendFormat": "{{ifDescr}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  }
 ]
}