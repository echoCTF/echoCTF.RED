{
 "uid": "platform-hosts",
 "title": "Platform hosts",
 "tags": [
  "echoctf"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "server",
    "label": "Server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(ifHCInOctets, instance)",
     "refId": "s"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "CPU busy per server, last minute average",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CPU $server",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "avg by (instance) (hrProcessorLoad{instance=~\"$server\"})",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "repeat": "server",
   "repeatDirection": "h",
   "maxPerRow": 3
  },
  {
   "type": "row",
   "title": "Memory used per server",
   "id": 3,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Memory $server",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * hrStorageUsed{instance=~\"$server\",hrStorageDescr=\"Physical memory\"} / hrStorageSize{instance=~\"$server\",hrStorageDescr=\"Physical memory\"}",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "repeat": "server",
   "repeatDirection": "h",
   "maxPerRow": 3
  },
  {
   "type": "row",
   "title": "Filesystems per server",
   "id": 5,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Filesystems $server",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * hrStorageUsed{instance=~\"$server\",hrStorageDescr=~\"/.*\"} / hrStorageSize{instance=~\"$server\",hrStorageDescr=~\"/.*\"}",
     "legendFormat": "{{hrStorageDescr}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "repeat": "server",
   "repeatDirection": "h",
   "maxPerRow": 3
  }
 ]
}