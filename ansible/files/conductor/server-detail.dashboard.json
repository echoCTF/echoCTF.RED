{
 "uid": "server-detail",
 "title": "Server detail",
 "tags": [
  "echoctf"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "server",
    "label": "Server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(ifHCInOctets, instance)",
     "refId": "s"
    },
    "refresh": 2,
    "includeAll": false,
    "multi": false,
    "current": {},
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Network",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Inbound",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(ifHCInOctets{instance=\"$server\",ifDescr!~\"enc0\"}[$__rate_interval]) * 8",
     "legendFormat": "{{ifDescr}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Outbound",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(ifHCOutOctets{instance=\"$server\",ifDescr!~\"enc0\"}[$__rate_interval]) * 8",
     "legendFormat": "{{ifDescr}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "row",
   "title": "Host",
   "id": 4,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CPU busy, last minute average",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "avg by (instance) (hrProcessorLoad{instance=\"$server\"})",
     "legendFormat": "cpu",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Memory and swap used",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 8,
    "y": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * hrStorageUsed{instance=\"$server\",hrStorageDescr=\"Physical memory\"} / hrStorageSize{instance=\"$server\",hrStorageDescr=\"Physical memory\"}",
     "legendFormat": "memory",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * hrStorageUsed{instance=\"$server\",hrStorageDescr=\"Swap space\"} / hrStorageSize{instance=\"$server\",hrStorageDescr=\"Swap space\"}",
     "legendFormat": "swap",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Filesystems used",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * hrStorageUsed{instance=\"$server\",hrStorageDescr=~\"/.*\"} / hrStorageSize{instance=\"$server\",hrStorageDescr=~\"/.*\"}",
     "legendFormat": "{{hrStorageDescr}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
