     "expr": "(label_replace(nfdump_window_bytes, \"instance\", \"$1.$2.$3.$4\", \"exporter\", \"([0-9]+)-([0-9]+)-([0-9]+)-([0-9]+)\") and on(instance) up{instance=\"$server\"})",
     "legendFormat": "bytes",
