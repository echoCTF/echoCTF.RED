#!/usr/bin/env php
<?php
/**
 * Yii console bootstrap file.
 *
 * @link http://www.yiiframework.com/
 * @copyright Copyright (c) 2008 Yii Software LLC
 * @license http://www.yiiframework.com/license/
 */

defined('YII_DEBUG') or define('YII_DEBUG', false);
defined('YII_ENV') or define('YII_ENV', 'prod');

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/../vendor/yiisoft/yii2/Yii.php';

$config = require __DIR__ . '/../config/console.php';

$application = new yii\console\Application($config);
$interval = getenv("INTERVAL") ?: 10;
while (true) {
  try {
    $application->runAction('cron/instances', array_slice($argv, 1));
  } catch (\PDOException | \yii\db\Exception $e) {
    \Yii::error($e->getMessage(), 'cron-instances');
    \Yii::$app->db->close();
  } catch (\Throwable $e) {
    Yii::error($e->getMessage() . "\n" . $e->getTraceAsString(), 'cron-instances');
  }

  \Yii::getLogger()->flush(true);
  gc_collect_cycles();
  sleep($interval);
}
